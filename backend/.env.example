VOICESCRIBE_SECRET_KEY=replace-with-a-long-random-string
VOICESCRIBE_DATABASE_URL=sqlite:///./storage/voicescribe.db
VOICESCRIBE_ACCESS_TOKEN_EXPIRE_MINUTES=1440

WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- AI features (summarizer, meeting notes, ask-a-question, rewrite) ----
# Leave blank to disable these endpoints (they'll respond with a clear 503 instead of erroring oddly).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Google sign-in (optional) ----
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# and set its redirect URI to <your-server>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Comma-separated emails that get admin rights automatically on register/login.
ADMIN_EMAILS=
